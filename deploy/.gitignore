# =============================================================================
# Sub2API Deploy Directory - Git Ignore
# =============================================================================

# Data directories (generated at runtime when using docker-compose.local.yml)
data/
postgres_data/
redis_data/

# Environment configuration (contains sensitive information)
.env

# Backup files
*.backup
*.bak

# Temporary files
*.tmp
*.log

# =============================================================================
# Monitoring - 渲染产物与本地环境
# =============================================================================
# Prometheus 配置渲染产物（由 render-prometheus-config.sh 生成，不入库）
monitoring/prometheus.yml

# 监控环境文件（含 GRAFANA_ADMIN_PASSWORD）
monitoring.env

# 备份产物目录（运行时生成）
monitoring/backup-data/

# Generated deployment command and application image override
sub2api-compose
docker-compose.release.yml
*.tmp.*

# Python bytecode from deploy/tests
__pycache__/
*.pyc
