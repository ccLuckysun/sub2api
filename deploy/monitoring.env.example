# =============================================================================
# Sub2API Monitoring Environment - Example
# =============================================================================
# 复制为 monitoring.env 并按需修改：
#   cp monitoring.env.example monitoring.env
#
# 一键部署会自动生成密码与配置，已有文件不会被覆盖：
#   ./compose-deploy.sh --monitoring --compose-file docker-compose.dev.yml
# 后续使用生成的 ./sub2api-compose 管理服务，它会按顺序读取 .env / monitoring.env。
# 默认六个容器（含 Alertmanager）；Node Exporter 和快照 cron 需显式 --host-metrics / --backup。
#
# monitoring.env 含敏感信息（管理员密码），已列入 deploy/.gitignore 不入库。
#
# 变量默认值按 2 核 / 2GB / 50GB 服务器规格回填（DEV_PLAN 5.1/5.2 节），
# 均为初始值，部署后按实测校准。
# =============================================================================

# -----------------------------------------------------------------------------
# Grafana
# -----------------------------------------------------------------------------
# Grafana 管理员密码（必填，无默认值；禁默认 admin）
# 长度至少 8 位，建议随机生成：openssl rand -base64 16
GRAFANA_ADMIN_PASSWORD=

# Grafana 容器内存上限：13.3.1 本地实测冷启动逼近旧上限 256MiB，
# 提高到 384MiB 留插件/页缓存余量。2GB 生产预算须连同业务栈重新评估，
# 本地启动通过不代表生产一定承载得住。
GRAFANA_MEMORY_LIMIT=384m

# -----------------------------------------------------------------------------
# Prometheus - 采集
# -----------------------------------------------------------------------------
# 抓取间隔：2 核机器取15s，以满足 V2 定位时延预算
PROM_SCRAPE_INTERVAL=15s

# 抓取超时（须小于抓取间隔）
PROM_SCRAPE_TIMEOUT=10s

# -----------------------------------------------------------------------------
# Prometheus - 数据保留
# -----------------------------------------------------------------------------
# 指标保留时间上界（time 与 size 先到者生效；size 先到时实际保留不足 90 天）
PROM_RETENTION_TIME=90d

# TSDB 块容量上限（先到先删）。注意：它不是数据目录硬上限，
# WAL/head/快照/备份需额外空间，删除为异步过程，不能当磁盘配额依赖
PROM_RETENTION_SIZE=8GB

# -----------------------------------------------------------------------------
# 可选备份（--backup 启用：快照 -> tar.gz -> 清理旧包）
# -----------------------------------------------------------------------------
# 快照时刻，alpine crond 5 字段格式（明确 UTC；默认每日 04:00 UTC，
# 北京时间 12:00；Alpine 不预装 tzdata，不能只改 TZ 当作时区已生效）
# 示例：0 4 * * *      -> 每日 04:00 UTC
#       0 */6 * * *    -> 每 6 小时
SNAPSHOT_SCHEDULE=0 4 * * *

# 备份包保留天数（独立于 TSDB retention；每日快照含整个保留窗口，
# 多份瞬时共存，50GB 磁盘下取小值）
SNAPSHOT_KEEP_DAYS=3

# -----------------------------------------------------------------------------
# 应用指标端点（叠加 compose 默认已启用，一般无需改动）
# -----------------------------------------------------------------------------
# docker-compose.monitoring.yml 的 sub2api 服务注入这两个变量启用 9091 指标端点；
# 置 false 可在不撤掉监控栈的情况下单独关闭应用指标
# MONITORING_METRICS_ENABLED=true
# MONITORING_METRICS_BIND=0.0.0.0:9091
# V2 埋点与 PG 样本（叠加 compose 默认 true；关闭时看板显示“埋点未启用”）
# MONITORING_OPS_METRICS_ENABLED=true
# MONITORING_OPS_SAMPLES_ENABLED=true
# OPS_SAMPLE_RETENTION_DAYS=30

# -----------------------------------------------------------------------------
# 通用
# -----------------------------------------------------------------------------
# 时区（与业务容器保持一致）
TZ=Asia/Shanghai

# dev compose 必需 POSTGRES_PASSWORD，新部署建议保存在业务 .env。
# 一键脚本按 .env、monitoring.env 顺序读取，已有的下述旧配置仍兼容。
# 手动使用 docker compose 时须同时 --env-file .env --env-file monitoring.env。
# POSTGRES_PASSWORD=
# 其余变量可选（Redis 启用密码时应用与 Redis 使用同一值）：
# POSTGRES_USER=sub2api
# POSTGRES_DB=sub2api
# REDIS_PASSWORD=
# BIND_HOST=127.0.0.1
# SERVER_PORT=8080

# Default V2 deployment contains six core containers. Optional extensions are separate
# containers: ./compose-deploy.sh --host-metrics and/or --backup.
MONITORING_HOST_METRICS_ENABLED=false
MONITORING_BACKUP_ENABLED=false
# Set automatically from Docker's private bridge gateway with --host-metrics.
# NODE_EXPORTER_HOST_IP=172.17.0.1
# Host-side Grafana port (always bound to 127.0.0.1)
GRAFANA_PORT=3000

# V2: compose-deploy.sh 会自动生成密码并执行 sql/grafana-ro.sql；
# 手工部署时需自行设置并执行该 SQL。
GRAFANA_PG_PASSWORD=
# Email is disabled until a recipient is configured. Set a real SMTP relay and
# recipient together in monitoring.env; never commit credentials.
ALERT_SMTP_SMARTHOST=localhost:1025
ALERT_SMTP_FROM=sub2api@localhost
ALERT_SMTP_AUTH_USERNAME=
ALERT_SMTP_AUTH_PASSWORD=
ALERT_SMTP_REQUIRE_TLS=true
ALERT_SMTP_TO=
