    {
      "id": 10,
      "title": "链路段耗时占比",
      "type": "bargauge",
      "description": "当前 $__range 内 6 个互斥链路段平均耗时（sum/count，排除与 upstream 重叠的 headers_end）。均值受长流式请求拉高，排查看 02 页 P95。",
      "datasource": {
        "type": "prometheus",
        "uid": "sub2api-prometheus"
      },
      "gridPos": {
        "h": 10,
        "w": 9,
        "x": 0,
        "y": 6
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "sub2api-prometheus"
          },
          "expr": "sum by (phase)(increase(sub2api_request_phase_seconds_sum{phase!=\"headers_end\"}[$__range])) / clamp_min(sum by (phase)(increase(sub2api_request_phase_seconds_count{phase!=\"headers_end\"}[$__range])), 1)",
          "legendFormat": "{{phase}}",
          "range": false,
          "instant": true
        }
      ],
      "interval": "15s",
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "decimals": 3,
          "noValue": "无流量",
          "mappings": [],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "#3ecf8e",
                "value": null
              }
            ]
          },
          "min": 0,
          "color": {
            "mode": "thresholds"
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "body_read"
            },
            "properties": [
              {
                "id": "displayName",
                "value": "读取请求体"
              },
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "#3987e5"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "wait"
            },
            "properties": [
              {
                "id": "displayName",
                "value": "槽位等待"
              },
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "#1aa57a"
