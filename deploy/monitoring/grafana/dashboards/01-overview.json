          "expr": "(sum by (phase)(rate(sub2api_request_phase_seconds_sum{phase!=\"headers_end\"}[$__rate_interval])) / clamp_min(sum(rate(sub2api_request_phase_seconds_sum{phase!=\"headers_end\"}[$__rate_interval])),1e-9)*100) or (label_replace(vector(0), \"collection\", \"未采集\", \"\", \"\") unless on() (sum by (phase)(rate(sub2api_request_phase_seconds_sum{phase!=\"headers_end\"}[$__rate_interval])) / clamp_min(sum(rate(sub2api_request_phase_seconds_sum{phase!=\"headers_end\"}[$__rate_interval])),1e-9)*100))",
