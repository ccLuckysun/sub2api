      "title": "请求速率 QPS",
      "type": "timeseries",
      "description": "网关请求与上游尝试分开：重试会让上游尝试高于网关请求。 口径按 V2 契约；缺序列显示未采集，0 不代表请求成功。",
      "datasource": {
        "type": "prometheus",
        "uid": "sub2api-prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 12,
        "w": 6,
        "h": 7
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "sub2api-prometheus"
          },
          "expr": "(sum(rate(sub2api_gateway_requests_total[$__rate_interval]))) or (label_replace(vector(0), \"collection\", \"未采集\", \"\", \"\") unless on() (sum(rate(sub2api_gateway_requests_total[$__rate_interval]))))",
          "legendFormat": "{{collection}} {{account}} {{phase}} {{result}} {{direction}} {{stage}} {{kind}} {{model_class}}",
          "range": true,
