{
  "uid": "sub2api-v2-overview",
  "title": "01 · 总览",
  "schemaVersion": 39,
  "version": 1,
  "editable": false,
  "allowUiUpdates": false,
  "timezone": "browser",
  "refresh": "30s",
  "time": {
    "from": "now-15m",
    "to": "now"
  },
  "tags": [
    "sub2api",
    "v2"
  ],
  "panels": [
    {
      "id": 1,
      "title": "",
      "type": "text",
      "description": "模块导航。Grafana 原生没有 Tab，使用文本链接等价实现；右侧跳转管理后台 Redis 实时请求流。",
      "datasource": {
        "type": "prometheus",
        "uid": "sub2api-prometheus"
      },
      "gridPos": {
        "h": 2,
        "w": 24,
        "x": 0,
        "y": 0
      },
      "targets": [],
      "interval": "15s",
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 0,
          "noValue": "未采集",
          "mappings": [],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "#3ecf8e",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "mode": "html",
        "content": "<div style=\"display:flex;align-items:center;justify-content:space-between;flex-wrap:wrap;gap:6px\"><div style=\"display:flex;align-items:center;flex-wrap:wrap\"><a href=\"/d/sub2api-v2-overview\" style=\"display:inline-block;padding:5px 12px;margin-right:5px;border-radius:5px;font-size:12px;text-decoration:none;font-weight:600;background:#1c2229;color:#f4f5f5;border:1px solid #323a43\">01 总览</a><a href=\"/d/sub2api-v2-nodes-chain\" style=\"display:inline-block;padding:5px 12px;margin-right:5px;border-radius:5px;font-size:12px;text-decoration:none;font-weight:500;background:transparent;color:#828c97;border:1px solid transparent\">02 上游节点与链路</a><a href=\"/d/sub2api-v2-host\" style=\"display:inline-block;padding:5px 12px;margin-right:5px;border-radius:5px;font-size:12px;text-decoration:none;font-weight:500;background:transparent;color:#828c97;border:1px solid transparent\">03 宿主与应用</a></div><a href=\"${admin_url}/admin/ops#realtime-requests\" target=\"_blank\" rel=\"noopener noreferrer\" title=\"实时请求流与单请求明细运行在 Sub2API 管理后台（基于 Redis 环形缓冲；可在顶部「管理后台地址」变量修改域名/端口）\" style=\"display:inline-block;padding:5px 12px;border-radius:999px;font-size:12px;text-decoration:none;font-weight:500;color:#8cc8ff;border:1px solid rgba(57,135,229,.45);background:rgba(57,135,229,.12)\">实时请求流（管理后台）↗</a></div>",
        "codeLanguage": "plaintext",
        "codeShowLineNumbers": false,
        "renderMode": "once"
      }
    },
    {
      "id": 2,
      "title": "网关 QPS",
      "type": "stat",
      "description": "网关请求速率（含 0-attempt 失败）；不是上游 attempt 速率。重试会让上游 attempt 高于此值。",
      "datasource": {
        "type": "prometheus",
        "uid": "sub2api-prometheus"
      },
      "gridPos": {
        "h": 4,
        "w": 3,
        "x": 0,
        "y": 2
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "sub2api-prometheus"
          },
          "expr": "sum(rate(sub2api_gateway_requests_total[$__rate_interval]))",
          "legendFormat": "网关 QPS",
          "range": false,
          "instant": true
        }
      ],
      "interval": "15s",
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "decimals": 1,
          "noValue": "无流量",
          "mappings": [],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "#3ecf8e",
                "value": null
              }
            ]
          },
          "color": {
            "mode": "fixed",
            "fixedColor": "#e6e9ed"
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byRegexp",
              "options": ".*未采集.*"
            },
            "properties": [
              {
                "id": "displayName",
                "value": "未采集"
              }
            ]
          }
        ]
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "none",
        "graphMode": "none",
        "justifyMode": "center",
        "orientation": "auto",
        "textMode": "value",
        "wideLayout": true,
        "showPercentChange": false,
        "text": {
          "valueSize": 26,
          "titleSize": 10
        }
      }
    },
    {
      "id": 3,
      "title": "成功率（1h）",
      "type": "stat",
      "description": "1h 内 M-10 成功网关请求占比。业务失败可能发生在已写出 200 的 SSE 中，不能只看 HTTP 5xx。",
      "datasource": {
        "type": "prometheus",
        "uid": "sub2api-prometheus"
      },
      "gridPos": {
        "h": 4,
        "w": 3,
        "x": 3,
        "y": 2
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "sub2api-prometheus"
          },
          "expr": "(sum(rate(sub2api_gateway_requests_total{result=\"success\"}[1h])) or sum(rate(sub2api_gateway_requests_total[1h])) * 0) / clamp_min(sum(rate(sub2api_gateway_requests_total[1h])), 1e-9)",
          "legendFormat": "成功率",
          "range": false,
          "instant": true
        }
      ],
      "interval": "15s",
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "decimals": 2,
          "noValue": "无流量",
          "mappings": [],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "#6c7782",
                "value": null
              },
              {
                "color": "#ef6b6b",
                "value": 0
              },
              {
                "color": "#f5b942",
                "value": 0.95
              },
              {
                "color": "#3ecf8e",
                "value": 0.99
              }
            ]
          },
          "color": {
            "mode": "thresholds"
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byRegexp",
              "options": ".*未采集.*"
            },
            "properties": [
              {
                "id": "displayName",
                "value": "未采集"
              }
            ]
          }
        ]
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "center",
        "orientation": "auto",
        "textMode": "value",
        "wideLayout": true,
        "showPercentChange": false,
        "text": {
          "valueSize": 26,
          "titleSize": 10
        }
      }
    },
    {
      "id": 4,
      "title": "P95 总耗时",
      "type": "stat",
      "description": "当前 $__range 内网关总耗时直方图 P95；受桶边界插值影响，不是各段 P95 相加。",
      "datasource": {
        "type": "prometheus",
        "uid": "sub2api-prometheus"
      },
      "gridPos": {
        "h": 4,
        "w": 3,
        "x": 6,
        "y": 2
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "sub2api-prometheus"
          },
          "expr": "histogram_quantile(0.95, sum by (le)(rate(sub2api_gateway_request_duration_seconds_bucket[$__range])))",
          "legendFormat": "P95 总耗时",
          "range": false,
          "instant": true
