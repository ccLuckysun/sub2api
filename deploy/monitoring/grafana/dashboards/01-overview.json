            "steps": [
              {
                "color": "#6c7782",
                "value": null
              },
              {
                "color": "#3ecf8e",
                "value": 0
              },
              {
                "color": "#f5b942",
                "value": 3
              },
              {
                "color": "#ef6b6b",
                "value": 8
              }
            ]
          },
          "color": {
            "mode": "thresholds"
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byRegexp",
              "options": ".*未采集.*"
            },
            "properties": [
              {
                "id": "displayName",
                "value": "未采集"
              }
            ]
          }
        ]
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "center",
        "orientation": "auto",
        "textMode": "value",
        "wideLayout": true,
        "showPercentChange": false,
        "text": {
          "valueSize": 26,
          "titleSize": 10
