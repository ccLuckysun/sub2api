    {
      "id": 12,
      "title": "失败根因 Top",
      "type": "barchart",
      "description": "请求视角的 13 类根因。unknown 长期 >10% 说明分类缺失，不能当成“其他”。 口径按 V2 契约；缺序列显示未采集，0 不代表请求成功。",
      "datasource": {
        "type": "prometheus",
        "uid": "sub2api-prometheus"
      },
      "gridPos": {
        "x": 18,
        "y": 12,
        "w": 6,
        "h": 7
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "sub2api-prometheus"
          },
