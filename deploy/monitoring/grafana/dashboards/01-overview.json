    {
      "id": 8,
      "title": "分层错误瀑布",
      "type": "timeseries",
      "description": "按 result 堆叠的失败构成。看“谁在涨”，不要把所有非 2xx 混在一起。 口径按 V2 契约；缺序列显示未采集，0 不代表请求成功。",
      "datasource": {
        "type": "prometheus",
        "uid": "sub2api-prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 4,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "sub2api-prometheus"
          },
          "expr": "(sum by (result) (rate(sub2api_gateway_requests_total{result!=\"success\"}[$__rate_interval]))) or (label_replace(vector(0), \"collection\", \"未采集\", \"\", \"\") unless on() (sum by (result) (rate(sub2api_gateway_requests_total{result!=\"success\"}[$__rate_interval]))))",
          "legendFormat": "{{collection}} {{account}} {{phase}} {{result}} {{direction}} {{stage}} {{kind}} {{model_class}}",
          "range": true,
          "instant": false
        }
      ],
      "interval": "15s",
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "noValue": "未采集",
          "mappings": [],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          },
          "custom": {
            "stacking": {
              "mode": "normal",
              "group": "A"
            }
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byRegexp",
