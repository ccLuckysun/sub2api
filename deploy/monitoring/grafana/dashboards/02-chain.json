{
  "uid": "sub2api-v2-chain",
  "title": "02 · 链路归因",
  "schemaVersion": 39,
  "version": 1,
  "editable": false,
  "allowUiUpdates": false,
  "timezone": "browser",
  "refresh": "10s",
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "tags": [
    "sub2api",
    "v2"
  ],
  "panels": [
    {
      "id": 1,
      "title": "段耗时 P95 堆叠（6 互斥段）",
      "type": "timeseries",
      "description": "各互斥段分别取 P95，仅用于识别主导段；各段 P95 之和不是总 P95，也不是同一请求分解。排除 headers_end。",
      "datasource": {
        "type": "prometheus",
        "uid": "sub2api-prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 14,
        "h": 10
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "sub2api-prometheus"
          },
          "expr": "(histogram_quantile(0.95, sum by (le,phase)(rate(sub2api_request_phase_seconds_bucket{phase!=\"headers_end\"}[$__rate_interval])))) or (label_replace(vector(0), \"collection\", \"未采集\", \"\", \"\") unless on() (histogram_quantile(0.95, sum by (le,phase)(rate(sub2api_request_phase_seconds_bucket{phase!=\"headers_end\"}[$__rate_interval])))))",
          "legendFormat": "{{collection}} {{account}} {{phase}} {{result}} {{direction}} {{stage}} {{kind}} {{model_class}}",
          "range": true,
          "instant": false
        }
      ],
      "interval": "15s",
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "noValue": "未采集",
          "mappings": [],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          },
          "custom": {
            "stacking": {
              "mode": "normal",
              "group": "A"
            }
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byRegexp",
              "options": ".*未采集.*"
            },
            "properties": [
              {
                "id": "displayName",
                "value": "未采集"
              }
            ]
          }
        ]
      },
      "options": {}
    },
    {
      "id": 2,
      "title": "段均值占比",
      "type": "piechart",
      "description": "均值占比可堆叠；P95 占比不可堆叠。两者不要混用。 口径按 V2 契约；缺序列显示未采集，0 不代表请求成功。",
      "datasource": {
        "type": "prometheus",
        "uid": "sub2api-prometheus"
      },
      "gridPos": {
        "x": 14,
        "y": 0,
        "w": 10,
        "h": 10
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "sub2api-prometheus"
          },
          "expr": "(sum by (phase)(rate(sub2api_request_phase_seconds_sum{phase!=\"headers_end\"}[$__rate_interval])) / clamp_min(sum(rate(sub2api_request_phase_seconds_sum{phase!=\"headers_end\"}[$__rate_interval])),1e-9)*100) or (label_replace(vector(0), \"collection\", \"未采集\", \"\", \"\") unless on() (sum by (phase)(rate(sub2api_request_phase_seconds_sum{phase!=\"headers_end\"}[$__rate_interval])) / clamp_min(sum(rate(sub2api_request_phase_seconds_sum{phase!=\"headers_end\"}[$__rate_interval])),1e-9)*100))",
          "legendFormat": "{{collection}} {{account}} {{phase}} {{result}} {{direction}} {{stage}} {{kind}} {{model_class}}",
          "range": true,
          "instant": true
        }
      ],
      "interval": "15s",
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "noValue": "未采集",
          "mappings": [],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byRegexp",
              "options": ".*未采集.*"
            },
            "properties": [
              {
                "id": "displayName",
                "value": "未采集"
              }
            ]
          }
        ]
      },
      "options": {}
    },
    {
      "id": 3,
      "title": "TTFT 分位（P50 / P95 / P99）",
      "type": "timeseries",
      "description": "最终 attempt 首次发送至其首字节；与 upstream 重叠，无首字节不观察。不得与段耗时相加。",
      "datasource": {
        "type": "prometheus",
        "uid": "sub2api-prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 10,
        "w": 8,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "sub2api-prometheus"
          },
          "expr": "(histogram_quantile(0.5, sum by (le)(rate(sub2api_request_phase_seconds_bucket{phase=\"headers_end\"}[$__rate_interval])))) or (label_replace(vector(0), \"collection\", \"未采集\", \"\", \"\") unless on() (histogram_quantile(0.5, sum by (le)(rate(sub2api_request_phase_seconds_bucket{phase=\"headers_end\"}[$__rate_interval])))))",
          "legendFormat": "{{collection}} {{account}} {{phase}} {{result}} {{direction}} {{stage}} {{kind}} {{model_class}}",
          "range": true,
          "instant": false
        },
        {
          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "sub2api-prometheus"
          },
          "expr": "(histogram_quantile(0.95, sum by (le)(rate(sub2api_request_phase_seconds_bucket{phase=\"headers_end\"}[$__rate_interval])))) or (label_replace(vector(0), \"collection\", \"未采集\", \"\", \"\") unless on() (histogram_quantile(0.95, sum by (le)(rate(sub2api_request_phase_seconds_bucket{phase=\"headers_end\"}[$__rate_interval])))))",
          "legendFormat": "{{collection}} {{account}} {{phase}} {{result}} {{direction}} {{stage}} {{kind}} {{model_class}}",
          "range": true,
          "instant": false
        },
        {
          "refId": "C",
          "datasource": {
            "type": "prometheus",
            "uid": "sub2api-prometheus"
          },
          "expr": "(histogram_quantile(0.99, sum by (le)(rate(sub2api_request_phase_seconds_bucket{phase=\"headers_end\"}[$__rate_interval])))) or (label_replace(vector(0), \"collection\", \"未采集\", \"\", \"\") unless on() (histogram_quantile(0.99, sum by (le)(rate(sub2api_request_phase_seconds_bucket{phase=\"headers_end\"}[$__rate_interval])))))",
          "legendFormat": "{{collection}} {{account}} {{phase}} {{result}} {{direction}} {{stage}} {{kind}} {{model_class}}",
          "range": true,
          "instant": false
        }
      ],
      "interval": "15s",
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "noValue": "未采集",
          "mappings": [],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byRegexp",
              "options": ".*未采集.*"
            },
            "properties": [
              {
                "id": "displayName",
                "value": "未采集"
              }
            ]
          }
        ]
      },
      "options": {}
    },
    {
      "id": 4,
      "title": "每方向字节速率",
      "type": "timeseries",
      "description": "5 个方向的实际读写字节。resp_upstream 是解压后长度，无法与 wire 完全对账。 口径按 V2 契约；缺序列显示未采集，0 不代表请求成功。",
      "datasource": {
        "type": "prometheus",
        "uid": "sub2api-prometheus"
      },
      "gridPos": {
        "x": 8,
        "y": 10,
        "w": 8,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "sub2api-prometheus"
          },
          "expr": "(sum by (direction) (rate(sub2api_transfer_bytes_total[$__rate_interval]))) or (label_replace(vector(0), \"collection\", \"未采集\", \"\", \"\") unless on() (sum by (direction) (rate(sub2api_transfer_bytes_total[$__rate_interval]))))",
          "legendFormat": "{{collection}} {{account}} {{phase}} {{result}} {{direction}} {{stage}} {{kind}} {{model_class}}",
          "range": true,
          "instant": false
        }
      ],
      "interval": "15s",
      "fieldConfig": {
        "defaults": {
          "unit": "Bps",
          "noValue": "未采集",
          "mappings": [],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byRegexp",
              "options": ".*未采集.*"
            },
            "properties": [
              {
                "id": "displayName",
                "value": "未采集"
              }
            ]
          }
        ]
      },
      "options": {}
    },
    {
      "id": 5,
      "title": "字节平衡（上游 vs 下发）",
      "type": "timeseries",
      "description": "差额是上游返回与客户端收到的差。协议转换、重试失败体、客户端 abort、网关截断都会造成差额；不能只看差额就下结论。 口径按 V2 契约；缺序列显示未采集，0 不代表请求成功。",
      "datasource": {
        "type": "prometheus",
        "uid": "sub2api-prometheus"
      },
      "gridPos": {
        "x": 16,
        "y": 10,
        "w": 8,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "sub2api-prometheus"
          },
          "expr": "(sum(rate(sub2api_transfer_bytes_total{direction=\"resp_upstream\"}[$__rate_interval]))) or (label_replace(vector(0), \"collection\", \"未采集\", \"\", \"\") unless on() (sum(rate(sub2api_transfer_bytes_total{direction=\"resp_upstream\"}[$__rate_interval]))))",
          "legendFormat": "{{collection}} {{account}} {{phase}} {{result}} {{direction}} {{stage}} {{kind}} {{model_class}}",
          "range": true,
          "instant": false
        },
        {
          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "sub2api-prometheus"
          },
          "expr": "(sum(rate(sub2api_transfer_bytes_total{direction=\"resp_downstream\"}[$__rate_interval]))) or (label_replace(vector(0), \"collection\", \"未采集\", \"\", \"\") unless on() (sum(rate(sub2api_transfer_bytes_total{direction=\"resp_downstream\"}[$__rate_interval]))))",
          "legendFormat": "{{collection}} {{account}} {{phase}} {{result}} {{direction}} {{stage}} {{kind}} {{model_class}}",
          "range": true,
          "instant": false
        },
        {
          "refId": "C",
          "datasource": {
            "type": "prometheus",
            "uid": "sub2api-prometheus"
          },
          "expr": "(sum(rate(sub2api_transfer_bytes_total{direction=\"resp_upstream\"}[$__rate_interval])) - sum(rate(sub2api_transfer_bytes_total{direction=\"resp_downstream\"}[$__rate_interval]))) or (label_replace(vector(0), \"collection\", \"未采集\", \"\", \"\") unless on() (sum(rate(sub2api_transfer_bytes_total{direction=\"resp_upstream\"}[$__rate_interval])) - sum(rate(sub2api_transfer_bytes_total{direction=\"resp_downstream\"}[$__rate_interval]))))",
          "legendFormat": "{{collection}} {{account}} {{phase}} {{result}} {{direction}} {{stage}} {{kind}} {{model_class}}",
          "range": true,
          "instant": false
        }
      ],
      "interval": "15s",
      "fieldConfig": {
        "defaults": {
          "unit": "Bps",
          "noValue": "未采集",
          "mappings": [],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byRegexp",
              "options": ".*未采集.*"
            },
            "properties": [
              {
                "id": "displayName",
                "value": "未采集"
              }
            ]
          }
        ]
      },
      "options": {}
    },
    {
      "id": 6,
      "title": "上游 − 下发差额占比",
      "type": "timeseries",
      "description": "差额 / 上游字节。>20% 时结合 02 的客户端中断、错误根因和单请求样本判断，不直接等同“网关截断”。 口径按 V2 契约；缺序列显示未采集，0 不代表请求成功。",
      "datasource": {
        "type": "prometheus",
        "uid": "sub2api-prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 18,
        "w": 8,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "sub2api-prometheus"
          },
          "expr": "((sum(rate(sub2api_transfer_bytes_total{direction=\"resp_upstream\"}[10m])) - sum(rate(sub2api_transfer_bytes_total{direction=\"resp_downstream\"}[10m]))) / clamp_min(sum(rate(sub2api_transfer_bytes_total{direction=\"resp_upstream\"}[10m])),1)*100) or (label_replace(vector(0), \"collection\", \"未采集\", \"\", \"\") unless on() ((sum(rate(sub2api_transfer_bytes_total{direction=\"resp_upstream\"}[10m])) - sum(rate(sub2api_transfer_bytes_total{direction=\"resp_downstream\"}[10m]))) / clamp_min(sum(rate(sub2api_transfer_bytes_total{direction=\"resp_upstream\"}[10m])),1)*100))",
          "legendFormat": "{{collection}} {{account}} {{phase}} {{result}} {{direction}} {{stage}} {{kind}} {{model_class}}",
          "range": true,
          "instant": false
        }
      ],
      "interval": "15s",
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "noValue": "未采集",
          "mappings": [],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byRegexp",
