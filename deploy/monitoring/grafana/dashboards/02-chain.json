    {
      "id": 7,
      "title": "失败根因速率（请求视角）",
      "type": "timeseries",
      "description": "M-10 请求视角，含 0-attempt 的网关拒绝。与 M-4 的上游 attempt 视角不要混用。 口径按 V2 契约；缺序列显示未采集，0 不代表请求成功。",
      "datasource": {
        "type": "prometheus",
        "uid": "sub2api-prometheus"
      },
      "gridPos": {
        "x": 8,
        "y": 18,
        "w": 8,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "sub2api-prometheus"
          },
          "expr": "(sum by (result, failure_reason) (rate(sub2api_gateway_requests_total{result!=\"success\"}[$__rate_interval]))) or (label_replace(vector(0), \"collection\", \"未采集\", \"\", \"\") unless on() (sum by (result, failure_reason) (rate(sub2api_gateway_requests_total{result!=\"success\"}[$__rate_interval]))))",
          "legendFormat": "{{collection}} {{account}} {{phase}} {{result}} {{direction}} {{stage}} {{kind}} {{model_class}}",
          "range": true,
          "instant": false
        }
      ],
      "interval": "15s",
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "noValue": "未采集",
          "mappings": [],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          },
          "custom": {
            "stacking": {
              "mode": "normal",
              "group": "A"
            }
          }
