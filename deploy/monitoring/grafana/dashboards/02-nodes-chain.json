      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "sub2api-prometheus"
          },
          "expr": "sum by (account)(increase(sub2api_upstream_requests_total[$__range]))",
          "legendFormat": "",
          "range": false,
          "instant": true,
          "format": "table"
        },
        {
          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "sub2api-prometheus"
          },
          "expr": "sum by (account)(rate(sub2api_upstream_requests_total[$__range]))",
          "legendFormat": "",
          "range": false,
          "instant": true,
          "format": "table"
        },
        {
          "refId": "C",
          "datasource": {
            "type": "prometheus",
            "uid": "sub2api-prometheus"
          },
          "expr": "sum by (account)(rate(sub2api_upstream_requests_total{result!=\"success\"}[$__range])) / clamp_min(sum by (account)(rate(sub2api_upstream_requests_total[$__range])), 1e-9)",
          "legendFormat": "",
          "range": false,
          "instant": true,
          "format": "table"
        },
        {
          "refId": "D",
          "datasource": {
            "type": "prometheus",
            "uid": "sub2api-prometheus"
