    {
      "id": 4,
      "title": "重试后成功",
      "type": "stat",
      "description": "M-6 retried_success / 全部 attempt 结束事件，窗口内按 $__range。比例高说明账号仍可用但需要重试；无流量时无数据。",
      "datasource": {
        "type": "prometheus",
        "uid": "sub2api-prometheus"
      },
      "gridPos": {
        "h": 3,
        "w": 6,
        "x": 12,
        "y": 2
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "sub2api-prometheus"
          },
          "expr": "sum(increase(sub2api_attempts_total{outcome=\"retried_success\"}[$__range])) / clamp_min(sum(increase(sub2api_attempts_total[$__range])), 1)",
          "legendFormat": "重试后成功",
          "range": false,
          "instant": true
        }
      ],
      "interval": "15s",
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "decimals": 1,
          "noValue": "无流量",
          "mappings": [],
