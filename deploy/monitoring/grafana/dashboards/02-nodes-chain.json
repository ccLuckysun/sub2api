    {
      "id": 2,
      "title": "在线账号",
      "type": "stat",
      "description": "应用上报的活跃可调度账号数（sub2api_app_accounts_active）；代表配置状态，不代表上游此刻全部健康。",
      "datasource": {
        "type": "prometheus",
        "uid": "sub2api-prometheus"
      },
      "gridPos": {
        "h": 3,
        "w": 6,
        "x": 0,
        "y": 2
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "sub2api-prometheus"
          },
          "expr": "max(sub2api_app_accounts_active)",
          "legendFormat": "在线账号",
          "range": false,
          "instant": true
        }
      ],
      "interval": "15s",
      "fieldConfig": {
        "defaults": {
          "unit": "short",
