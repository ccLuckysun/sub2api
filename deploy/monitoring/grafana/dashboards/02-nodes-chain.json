    {
      "id": 6,
      "title": "账号健康矩阵",
      "type": "table",
      "description": "当前 $__range 内 Prometheus 上游 attempt 口径的请求数、QPS、失败率与 P95 TTFT；摘除/降权前先核实样本量。",
      "datasource": {
        "type": "prometheus",
        "uid": "sub2api-prometheus"
      },
      "gridPos": {
        "h": 10,
        "w": 14,
        "x": 0,
        "y": 5
