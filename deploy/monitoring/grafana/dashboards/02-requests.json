    {
      "id": 2,
      "title": "窗口内请求",
      "type": "stat",
      "description": "当前时间窗口内 PG 请求样本数；不是客户端缓冲，当前没有在途指标。无样本显示无流量，表格最多展示最新 200 行。",
      "datasource": {
        "type": "postgres",
        "uid": "sub2api-pg"
      },
      "gridPos": {
        "h": 3,
        "w": 6,
        "x": 0,
        "y": 2
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "postgres",
            "uid": "sub2api-pg"
          },
          "rawSql": "\nSELECT NULLIF(count(*), 0) AS \"窗口内请求\"\nFROM ops_request_transfer_samples s\nWHERE $__timeFilter(s.observed_at)\n  AND ($user = -1 OR s.user_id = $user)\n  AND ($api_key = -1 OR s.api_key_id = $api_key)\n  AND (${model:sqlstring} = '__all__' OR s.model = ${model:sqlstring})\n  AND (${result:sqlstring} = 'all'\n       OR (${result:sqlstring} = 'success' AND s.result = 'success')\n       OR (${result:sqlstring} = 'failure' AND s.result <> 'success'))\n",
          "format": "table",
          "rawQuery": true,
          "editorMode": "code"
        }
      ],
      "interval": "1m",
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 0,
          "noValue": "无流量",
          "mappings": [],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "#3ecf8e",
                "value": null
              }
            ]
          },
          "color": {
            "mode": "fixed",
            "fixedColor": "#e6e9ed"
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byRegexp",
              "options": ".*未采集.*"
            },
            "properties": [
              {
                "id": "displayName",
                "value": "未采集"
              }
            ]
          }
        ]
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
