              "options": ".*未采集.*"
            },
            "properties": [
              {
                "id": "displayName",
                "value": "未采集"
              }
            ]
          }
        ]
      },
      "options": {}
    },
    {
      "id": 6,
      "title": "用户错误构成",
      "type": "barchart",
      "description": "用户维度只看 PG 的 result，不细分 failure_reason（12 类只在 02 的链路面板展开）。 口径按 V2 契约；缺序列显示未采集，0 不代表请求成功。 使用 PG 请求样本（非 attempt），受落库覆盖率影响。 PG 最小查询间隔 1m；混合看板刷新限制见本地验收文档。",
      "datasource": {
        "type": "postgres",
        "uid": "sub2api-pg"
      },
      "gridPos": {
        "x": 12,
        "y": 16,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "postgres",
            "uid": "sub2api-pg"
          },
          "rawSql": "SELECT result,count(*) AS requests FROM ops_request_transfer_samples WHERE $__timeFilter(observed_at) AND ($user = -1 OR user_id = $user) AND ($api_key = -1 OR api_key_id = $api_key) GROUP BY result",
          "format": "table",
          "rawQuery": true,
          "editorMode": "code"
        }
