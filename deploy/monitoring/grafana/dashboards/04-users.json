    {
      "id": 5,
      "title": "用户延迟分位",
      "type": "timeseries",
      "description": "PG 精确分位，基于 usage_logs 全量样本（不是采样）。与 Prometheus 的 HTTP 延迟口径不同。 口径按 V2 契约；缺序列显示未采集，0 不代表请求成功。 PG 最小查询间隔 1m；混合看板刷新限制见本地验收文档。",
      "datasource": {
        "type": "postgres",
        "uid": "sub2api-pg"
      },
      "gridPos": {
        "x": 0,
        "y": 16,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "postgres",
            "uid": "sub2api-pg"
          },
          "rawSql": "SELECT $__timeGroupAlias(created_at,'5m'),percentile_cont(0.5) WITHIN GROUP (ORDER BY duration_ms)/1000 AS p50,percentile_cont(0.95) WITHIN GROUP (ORDER BY duration_ms)/1000 AS p95,percentile_cont(0.99) WITHIN GROUP (ORDER BY duration_ms)/1000 AS p99 FROM usage_logs WHERE $__timeFilter(created_at) AND ($user = -1 OR user_id = $user) AND ($api_key = -1 OR api_key_id = $api_key) GROUP BY 1 ORDER BY 1",
          "format": "time_series",
          "rawQuery": true,
          "editorMode": "code"
        }
      ],
      "interval": "1m",
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "noValue": "未采集",
          "mappings": [],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          }
        },
