    {
      "id": 6,
      "title": "用户用量",
      "type": "table",
      "description": "usage_logs 按用户聚合，成本列为 actual_cost；失败率来自 PG 请求样本。两种数据集覆盖范围不同，variables 只作用于含 user_id/api_key_id 的查询。",
      "datasource": {
        "type": "postgres",
        "uid": "sub2api-pg"
      },
      "gridPos": {
        "h": 10,
        "w": 24,
        "x": 0,
        "y": 5
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "postgres",
            "uid": "sub2api-pg"
          },
          "rawSql": "\nWITH sample AS (\n  SELECT user_id,\n         count(*) FILTER (WHERE result <> 'success') * 100.0 / count(*) AS failure_pct\n  FROM ops_request_transfer_samples\n  WHERE $__timeFilter(observed_at)\n  GROUP BY user_id\n)\nSELECT u.email || ' #' || ul.user_id AS \"用户\",\n       count(*) AS \"请求\",\n       sum(ul.input_tokens) AS \"输入 Token\",\n       sum(ul.output_tokens) AS \"输出 Token\",\n       sum(ul.cache_read_tokens + ul.cache_creation_tokens) AS \"缓存 Token\",\n       sum(ul.actual_cost) AS \"成本\",\n       round(COALESCE(max(s.failure_pct), 0)::numeric, 1) AS \"失败率\",\n       percentile_cont(0.95) WITHIN GROUP (ORDER BY ul.duration_ms) / 1000.0 AS \"P95 耗时\",\n       max(ul.created_at) AS \"最近活跃\",\n       CASE WHEN COALESCE(max(s.failure_pct), 0) > 5 THEN '观察' ELSE '正常' END AS \"状态\"\nFROM usage_logs ul\nJOIN users u ON u.id = ul.user_id\nLEFT JOIN sample s ON s.user_id = ul.user_id\nWHERE $__timeFilter(ul.created_at)\n  AND ($user = -1 OR ul.user_id = $user)\n  AND ($api_key = -1 OR ul.api_key_id = $api_key)\nGROUP BY ul.user_id, u.email\nORDER BY count(*) DESC\nLIMIT 100\n",
          "format": "table",
          "rawQuery": true,
          "editorMode": "code"
        }
      ],
      "interval": "1m",
