    {
      "id": 2,
      "title": "活跃用户",
      "type": "stat",
      "description": "今日 usage_logs 中去重 user_id 数。不是账号系统在线人数。",
      "datasource": {
        "type": "postgres",
        "uid": "sub2api-pg"
      },
      "gridPos": {
        "h": 3,
        "w": 6,
        "x": 0,
        "y": 2
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "postgres",
            "uid": "sub2api-pg"
          },
          "rawSql": "\nSELECT count(DISTINCT user_id) AS \"活跃用户\"\nFROM usage_logs\nWHERE created_at >= date_trunc('day', now() AT TIME ZONE 'Asia/Shanghai') AT TIME ZONE 'Asia/Shanghai'\n  AND ($user = -1 OR user_id = $user)\n  AND ($api_key = -1 OR api_key_id = $api_key)\n",
