    {
      "id": 10,
      "title": "DB 连接",
      "type": "timeseries",
      "description": "来自 ops_system_metrics 的应用侧连接数；与 PG 侧 pg_stat_activity 可能有时差。 口径按 V2 契约；缺序列显示未采集，0 不代表请求成功。 PG 最小查询间隔 1m；混合看板刷新限制见本地验收文档。",
      "datasource": {
        "type": "postgres",
        "uid": "sub2api-pg"
      },
      "gridPos": {
        "x": 0,
        "y": 24,
        "w": 8,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "postgres",
            "uid": "sub2api-pg"
          },
          "rawSql": "SELECT $__timeGroupAlias(created_at,'1m'),avg(db_conn_active) AS active,avg(db_conn_idle) AS idle FROM ops_system_metrics WHERE $__timeFilter(created_at) GROUP BY 1 ORDER BY 1",
          "format": "time_series",
          "rawQuery": true,
          "editorMode": "code"
        }
      ],
      "interval": "1m",
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "noValue": "未采集",
          "mappings": [],
