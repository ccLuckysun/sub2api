{
  "uid": "sub2api-v2-host",
  "title": "05 · 宿主与应用",
  "schemaVersion": 39,
  "version": 1,
  "editable": false,
  "allowUiUpdates": false,
  "timezone": "browser",
  "refresh": "30s",
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "tags": [
    "sub2api",
    "v2"
  ],
  "panels": [
    {
      "id": 1,
      "title": "宿主 CPU 使用率",
      "type": "timeseries",
      "description": "2 vCPU 机器的整机 CPU。process_* 是应用进程，不能与整机百分比直接对比。 口径按 V2 契约；缺序列显示未采集，0 不代表请求成功。",
      "datasource": {
        "type": "prometheus",
        "uid": "sub2api-prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 8,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "sub2api-prometheus"
          },
          "expr": "(100 - avg by(instance) (rate(node_cpu_seconds_total{mode=\"idle\"}[$__rate_interval])) * 100) or (label_replace(vector(0), \"collection\", \"未采集\", \"\", \"\") unless on() (100 - avg by(instance) (rate(node_cpu_seconds_total{mode=\"idle\"}[$__rate_interval])) * 100))",
          "legendFormat": "{{collection}} {{account}} {{phase}} {{result}} {{direction}} {{stage}} {{kind}} {{model_class}}",
          "range": true,
          "instant": false
        }
      ],
      "interval": "15s",
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "noValue": "未采集",
          "mappings": [],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byRegexp",
              "options": ".*未采集.*"
            },
            "properties": [
              {
                "id": "displayName",
                "value": "未采集"
              }
            ]
          }
        ]
      },
      "options": {}
    },
    {
      "id": 2,
      "title": "宿主内存",
      "type": "timeseries",
      "description": "swap 已用 800MB+ 时，内存压力会先体现在 load 与响应抖动，而不是 OOM。 口径按 V2 契约；缺序列显示未采集，0 不代表请求成功。",
      "datasource": {
        "type": "prometheus",
        "uid": "sub2api-prometheus"
      },
      "gridPos": {
        "x": 8,
        "y": 0,
        "w": 8,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "sub2api-prometheus"
          },
          "expr": "((1 - node_memory_MemAvailable_bytes / node_memory_MemTotal_bytes) * 100) or (label_replace(vector(0), \"collection\", \"未采集\", \"\", \"\") unless on() ((1 - node_memory_MemAvailable_bytes / node_memory_MemTotal_bytes) * 100))",
          "legendFormat": "{{collection}} {{account}} {{phase}} {{result}} {{direction}} {{stage}} {{kind}} {{model_class}}",
          "range": true,
          "instant": false
        }
      ],
      "interval": "15s",
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "noValue": "未采集",
          "mappings": [],
