    {
      "id": 9,
      "title": "Token 与费用",
      "type": "table",
      "description": "usage_logs 的 token 与 actual_cost（实际扣费）快照。费用与最终账单可能有舍入差异。",
      "datasource": {
        "type": "postgres",
        "uid": "sub2api-pg"
      },
      "gridPos": {
        "h": 8,
        "w": 10,
        "x": 0,
        "y": 22
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "postgres",
            "uid": "sub2api-pg"
          },
          "rawSql": "\nSELECT ul.input_tokens AS \"输入\",\n       ul.output_tokens AS \"输出\",\n       ul.cache_read_tokens AS \"缓存读\",\n       ul.cache_creation_tokens AS \"缓存写\",\n       ul.actual_cost AS \"费用\"\nFROM ops_request_transfer_samples s\nLEFT JOIN LATERAL (\n  SELECT ul.*\n  FROM usage_logs ul\n  WHERE ul.api_key_id = s.api_key_id\n    AND (ul.request_id = 'client:' || s.client_request_id\n         OR (NULLIF(s.client_request_id, '') IS NULL\n             AND ul.request_id = 'local:' || s.request_id))\n  ORDER BY (ul.request_id = 'client:' || s.client_request_id) DESC,\n           ul.created_at DESC\n  LIMIT 1\n) ul ON TRUE\nWHERE s.request_id = ${request:sqlstring} AND $__timeFilter(s.observed_at)\nORDER BY s.observed_at DESC\nLIMIT 1\n",
