    {
      "id": 7,
      "title": "转发链路分段",
      "type": "table",
      "description": "6 个互斥段的真实耗时（同一请求），颜色与总览一致。TTFT 与上游重叠，未放入六段。",
      "datasource": {
        "type": "postgres",
        "uid": "sub2api-pg"
      },
      "gridPos": {
        "h": 9,
        "w": 10,
        "x": 0,
        "y": 13
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "postgres",
            "uid": "sub2api-pg"
          },
          "rawSql": "\nWITH r AS (\n  SELECT *\n  FROM ops_request_transfer_samples\n  WHERE request_id = ${request:sqlstring} AND $__timeFilter(observed_at)\n  ORDER BY observed_at DESC\n  LIMIT 1\n), parts AS (\n  SELECT '读取请求体' AS phase, COALESCE(body_read_ms, 0) AS ms, total_ms FROM r\n  UNION ALL SELECT '槽位等待', COALESCE(wait_ms, 0), total_ms FROM r\n  UNION ALL SELECT '网关本地', COALESCE(gateway_ms, 0), total_ms FROM r\n  UNION ALL SELECT '上游耗时', COALESCE(upstream_ms, 0), total_ms FROM r\n  UNION ALL SELECT '响应传输', COALESCE(response_ms, 0), total_ms FROM r\n  UNION ALL SELECT '收尾', COALESCE(finish_ms, 0), total_ms FROM r\n)\nSELECT phase AS \"阶段\",\n       ms AS \"耗时\",\n       round(ms * 100.0 / NULLIF(total_ms, 0), 1) AS \"占比\"\nFROM parts\n",
          "format": "table",
          "rawQuery": true,
          "editorMode": "code"
        }
      ],
      "interval": "1m",
      "fieldConfig": {
        "defaults": {
          "unit": "ms",
          "decimals": 0,
          "noValue": "未采集",
          "mappings": [],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "#3ecf8e",
                "value": null
              }
            ]
          },
          "custom": {
            "align": "auto",
            "cellOptions": {
              "type": "auto"
            },
            "filterable": false,
            "inspect": false,
            "wrapText": false
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "阶段"
            },
            "properties": [
              {
                "id": "custom.width",
                "value": 120
              },
              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "color-text",
                  "mode": "basic"
                }
              },
              {
                "id": "mappings",
                "value": [
                  {
                    "type": "regex",
                    "options": {
                      "pattern": "^读取请求体$",
                      "result": {
                        "text": "读取请求体",
                        "color": "#3987e5"
                      }
                    }
                  },
                  {
                    "type": "regex",
                    "options": {
                      "pattern": "^槽位等待$",
                      "result": {
                        "text": "槽位等待",
                        "color": "#1aa57a"
                      }
                    }
                  },
                  {
                    "type": "regex",
                    "options": {
                      "pattern": "^网关本地$",
                      "result": {
                        "text": "网关本地",
                        "color": "#e07a3f"
                      }
                    }
                  },
                  {
                    "type": "regex",
                    "options": {
                      "pattern": "^上游耗时$",
                      "result": {
                        "text": "上游耗时",
                        "color": "#d4a72c"
                      }
                    }
                  },
                  {
                    "type": "regex",
                    "options": {
                      "pattern": "^响应传输$",
                      "result": {
                        "text": "响应传输",
                        "color": "#d9669a"
                      }
                    }
                  },
                  {
                    "type": "regex",
                    "options": {
                      "pattern": "^收尾$",
                      "result": {
                        "text": "收尾",
                        "color": "#9085e9"
                      }
                    }
                  }
                ]
              }
            ]
          },
          {
            "matcher": {
