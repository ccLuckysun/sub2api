    {
      "id": 10,
      "title": "失败信息",
      "type": "table",
      "description": "result/failure_reason/HTTP/attempt 结算。成功请求的 failure_reason 为空是正常值，不要当缺失。",
      "datasource": {
        "type": "postgres",
        "uid": "sub2api-pg"
      },
      "gridPos": {
        "h": 8,
        "w": 14,
        "x": 10,
        "y": 22
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "postgres",
            "uid": "sub2api-pg"
          },
          "rawSql": "\nSELECT CASE WHEN s.result = 'success' THEN '成功' ELSE '失败' END AS \"结果\",\n       CASE WHEN s.result = 'success' THEN '—' ELSE (CASE s.failure_reason\n  WHEN 'upstream_rate_limit' THEN '上游限流'\n  WHEN 'upstream_server_error' THEN '上游 5xx'\n  WHEN 'upstream_read_timeout' THEN '上游超时'\n  WHEN 'client_abort_during_response' THEN '客户端中断'\n  WHEN 'gateway_error' THEN '网关错误'\n  WHEN 'rejected' THEN '请求被拒'\n  WHEN 'unknown' THEN '未知'\n  ELSE COALESCE(s.failure_reason, s.result, 'unknown')\nEND) END AS \"失败原因\",\n       s.http_status AS \"HTTP 状态\",\n       s.attempt_count AS \"尝试次数\",\n       s.failed_attempts AS \"失败次数\",\n       s.node AS \"节点\"\nFROM ops_request_transfer_samples s\nWHERE s.request_id = ${request:sqlstring} AND $__timeFilter(s.observed_at)\nORDER BY s.observed_at DESC\nLIMIT 1\n",
          "format": "table",
          "rawQuery": true,
          "editorMode": "code"
        }
