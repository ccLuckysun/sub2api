    {
      "id": 6,
      "title": "基本信息",
      "type": "table",
      "description": "请求身份、模型映射、端点、分组与客户端信息。用户/IP/UA 来自 usage_logs，可能受异步落库时差影响。",
      "datasource": {
        "type": "postgres",
        "uid": "sub2api-pg"
      },
      "gridPos": {
        "h": 8,
        "w": 24,
        "x": 0,
        "y": 5
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "postgres",
            "uid": "sub2api-pg"
          },
          "rawSql": "\nSELECT COALESCE(u.email, '#' || s.user_id) AS \"用户\",\n       COALESCE(k.name, '—') AS \"API 密钥\",\n       COALESCE(a.name, '—') AS \"账户\",\n       COALESCE(g.name, '—') AS \"分组\",\n       s.model AS \"模型\",\n       COALESCE(ul.upstream_model, '—') AS \"上游模型\",\n       COALESCE(ul.inbound_endpoint, s.endpoint, '—') AS \"入站端点\",\n       COALESCE(ul.upstream_endpoint, '—') AS \"上游端点\",\n       CASE WHEN ul.stream IS TRUE THEN '流式'\n            WHEN ul.stream IS FALSE THEN '非流式'\n            ELSE '—' END AS \"类型\",\n       COALESCE(ul.billing_mode, '—') AS \"计费模式\",\n       s.observed_at AS \"时间\",\n       s.node AS \"节点\",\n       ul.ip_address AS \"客户端 IP\",\n       ul.user_agent AS \"User-Agent\"\nFROM ops_request_transfer_samples s\nLEFT JOIN LATERAL (\n  SELECT ul.*\n  FROM usage_logs ul\n  WHERE ul.api_key_id = s.api_key_id\n    AND (ul.request_id = 'client:' || s.client_request_id\n         OR (NULLIF(s.client_request_id, '') IS NULL\n             AND ul.request_id = 'local:' || s.request_id))\n  ORDER BY (ul.request_id = 'client:' || s.client_request_id) DESC,\n           ul.created_at DESC\n  LIMIT 1\n) ul ON TRUE\nLEFT JOIN users u ON u.id = s.user_id\nLEFT JOIN api_keys k ON k.id = s.api_key_id\nLEFT JOIN accounts a ON a.id = s.account_id\nLEFT JOIN groups g ON g.id = s.group_id\nWHERE s.request_id = ${request:sqlstring} AND $__timeFilter(s.observed_at)\nORDER BY s.observed_at DESC\nLIMIT 1\n",
          "format": "table",
          "rawQuery": true,
          "editorMode": "code"
        }
      ],
