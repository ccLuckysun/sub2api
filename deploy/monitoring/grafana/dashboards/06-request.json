    {
      "id": 2,
      "title": "总耗时",
      "type": "stat",
      "description": "该请求 total_ms。6 段互斥，之和应等于总耗时（±1ms）。",
      "datasource": {
        "type": "postgres",
        "uid": "sub2api-pg"
      },
      "gridPos": {
        "h": 3,
        "w": 6,
        "x": 0,
        "y": 2
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "postgres",
            "uid": "sub2api-pg"
          },
          "rawSql": "\nSELECT total_ms AS \"总耗时\"\nFROM ops_request_transfer_samples\nWHERE request_id = ${request:sqlstring} AND $__timeFilter(observed_at)\nORDER BY observed_at DESC LIMIT 1\n",
          "format": "table",
          "rawQuery": true,
          "editorMode": "code"
        }
      ],
      "interval": "1m",
      "fieldConfig": {
        "defaults": {
          "unit": "ms",
          "decimals": 0,
