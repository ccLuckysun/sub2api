    {
      "id": 8,
      "title": "字节流转",
      "type": "table",
      "description": "四方向实际读写字节与观测状态。上游/下发不守恒属正常（协议转换、SSE 重写、重试失败体、客户端中断）。",
      "datasource": {
        "type": "postgres",
        "uid": "sub2api-pg"
      },
      "gridPos": {
        "h": 9,
        "w": 14,
        "x": 10,
        "y": 13
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "postgres",
            "uid": "sub2api-pg"
          },
          "rawSql": "\nWITH r AS (\n  SELECT *\n  FROM ops_request_transfer_samples\n  WHERE request_id = ${request:sqlstring} AND $__timeFilter(observed_at)\n  ORDER BY observed_at DESC\n  LIMIT 1\n)\nSELECT * FROM (\n  SELECT '客户端请求体' AS \"方向\", bytes_in_wire AS \"字节\",\n         COALESCE(bytes_in_wire_status, 'unknown') AS \"状态\" FROM r\n  UNION ALL SELECT '解码后请求体', bytes_in_decoded, 'complete' FROM r\n  UNION ALL SELECT '发送上游请求体', bytes_up_req_total,\n         COALESCE(bytes_up_req_total_status, 'unknown') FROM r\n  UNION ALL SELECT '上游响应体（解压后）', bytes_resp_upstream,\n         COALESCE(bytes_resp_upstream_status, 'unknown') FROM r\n  UNION ALL SELECT '下发客户端响应体', bytes_resp_downstream,\n         COALESCE(bytes_resp_downstream_status, 'unknown') FROM r\n) x\n",
          "format": "table",
          "rawQuery": true,
          "editorMode": "code"
        }
