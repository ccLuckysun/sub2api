    {
      "datasource": {
        "type": "prometheus",
        "uid": "sub2api-prometheus"
      },
      "description": "4xx / 5xx 占总请求的比例。分母经 clamp_min 处理；分母为 0（无流量）时显示 no data 而非 0。",
      "fieldConfig": {
        "defaults": {
          "noValue": "no data",
          "unit": "percentunit",
          "min": 0,
          "max": 1
        },
        "overrides": []
      },
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 8,
        "y": 8
      },
      "id": 5,
      "options": {
        "legend": {
          "calcs": [
            "mean",
            "max"
          ],
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "pluginVersion": "13.3.1",
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "sub2api-prometheus"
          },
          "expr": "sum(rate(sub2api_http_requests_total{status_code=~\"4..\"}[5m])) / clamp_min(sum(rate(sub2api_http_requests_total[5m])), 0)",
          "legendFormat": "4xx 占比",
          "refId": "A"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "sub2api-prometheus"
          },
          "expr": "sum(rate(sub2api_http_requests_total{status_code=~\"5..\"}[5m])) / clamp_min(sum(rate(sub2api_http_requests_total[5m])), 0)",
          "legendFormat": "5xx 占比",
          "refId": "B"
        }
      ],
      "title": "4xx / 5xx 占比",
      "type": "timeseries"
    },
