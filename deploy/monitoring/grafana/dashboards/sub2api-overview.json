  "panels": [
    {
      "datasource": {
        "type": "prometheus",
        "uid": "sub2api-prometheus"
      },
      "description": "三个抓取目标的存活状态。up=1 仅代表该目标可采集，不代表业务健康（业务健康看 /health 与业务面板）。",
      "fieldConfig": {
        "defaults": {
          "mappings": [
            {
              "options": {
                "0": {
                  "color": "red",
                  "index": 1,
                  "text": "DOWN"
                },
                "1": {
                  "color": "green",
                  "index": 0,
                  "text": "UP"
                }
              },
              "type": "value"
            }
          ],
          "noValue": "no data",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "green",
                "value": 1
              }
            ]
          },
          "unit": "short"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 8,
        "w": 4,
        "x": 0,
        "y": 0
      },
      "id": 1,
      "options": {
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "auto",
        "orientation": "horizontal",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "showPercentChange": false,
        "textMode": "auto",
        "wideLayout": true
      },
      "pluginVersion": "13.3.1",
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "sub2api-prometheus"
          },
          "expr": "up",
          "legendFormat": "{{job}}",
          "range": false,
          "refId": "A"
        }
      ],
      "title": "采集目标状态 (up)",
      "type": "stat"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "sub2api-prometheus"
      },
      "description": "全部 HTTP 请求的总速率（先 sum 聚合各标签序列）。排除 /health、/setup/status、POST /api/event_logging/batch 等白名单路径。",
      "fieldConfig": {
        "defaults": {
          "noValue": "no data",
          "unit": "reqps"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 8,
        "w": 10,
        "x": 4,
        "y": 0
      },
      "id": 2,
      "options": {
        "legend": {
          "calcs": [
            "mean",
            "max"
          ],
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "pluginVersion": "13.3.1",
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "sub2api-prometheus"
          },
          "expr": "sum(rate(sub2api_http_requests_total[5m]))",
