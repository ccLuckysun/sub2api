          "legendFormat": "P95",
          "refId": "B"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "sub2api-prometheus"
          },
          "expr": "histogram_quantile(0.99, sum by (le) (rate(sub2api_http_request_duration_seconds_bucket{response_mode=\"other\"}[5m])))",
          "legendFormat": "P99",
          "refId": "C"
