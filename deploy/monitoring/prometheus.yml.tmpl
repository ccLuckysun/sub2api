# =============================================================================
# Sub2API Prometheus 采集配置模板
# =============================================================================
# 由 render-prometheus-config.sh 用 envsubst 渲染为 prometheus.yml。
# 原因：Prometheus 不对 bind-mount 配置文件做 ${VAR} 环境变量展开，
# Compose 也不会替换挂载文件的内容——模板占位符必须先渲染。
# 渲染产物 prometheus.yml 不入 Git（见 deploy/.gitignore）。
#
# 可用占位符（默认值见 monitoring.env.example）：
#   ${PROM_SCRAPE_INTERVAL}   全局抓取间隔
#   ${PROM_SCRAPE_TIMEOUT}    抓取超时
# =============================================================================

global:
  scrape_interval: ${PROM_SCRAPE_INTERVAL}
  scrape_timeout: ${PROM_SCRAPE_TIMEOUT}

scrape_configs:
  - job_name: sub2api
    # targets 用 Compose 服务名（网内 DNS）：服务 key 为 sub2api，
    # 与容器名 sub2api-dev 不同——compose 网络内 DNS 记录的是服务名。
    # 9091 为独立内部指标端口，不映射宿主机。
    static_configs:
      - targets: ["sub2api:9091"]

  - job_name: node
    # bridge 网络服务名（Node Exporter 非 host 网络，依赖服务名 DNS）
    static_configs:
      - targets: ["node-exporter:9100"]

  - job_name: prometheus
    # 自监控，辅助排障；up 只代表抓取目标可采集，不代表业务健康
    static_configs:
      - targets: ["localhost:9090"]
